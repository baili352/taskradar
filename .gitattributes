# 统一换行符，避免 Windows 克隆后 shell 脚本带 CRLF 导致容器内 exec 失败
* text=auto

# 容器内执行 / Linux 上执行：必须是 LF
*.sh            text eol=lf
Dockerfile      text eol=lf
*.conf          text eol=lf
*.template      text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.py            text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.json          text eol=lf
*.md            text eol=lf

# Windows 批处理：必须是 CRLF
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# 二进制，禁止任何转换
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.woff          binary
*.woff2         binary
*.db            binary
