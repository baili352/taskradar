# ===== 后端环境配置示例 =====
# 使用方法：复制本文件为 .env，再按需修改
# 命令：Copy-Item .env.example .env

# 应用名称
APP_NAME=办事雷达 TaskRadar AI
# 应用版本
APP_VERSION=0.1.0
# 运行环境：development / production
APP_ENV=development

# 后端监听地址与端口
HOST=127.0.0.1
PORT=8000

# 接口统一前缀
API_PREFIX=/api

# SQLite 数据库文件（相对路径基于 backend 目录）
DATABASE_PATH=./data/taskradar.db

# 允许跨域访问的前端地址（多个用英文逗号分隔，必须写完整的协议 + 主机 + 端口）
# 前端走 /api 代理时通常不需要跨域；若改为前后端直连，需把前端实际地址加进来。
# 端口回落示例（前端从 5173 改到 5174 / 5175 时）：
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
# 注意：start.bat 启动后端时会按实际前端端口设置环境变量 CORS_ORIGINS，
# 环境变量优先级高于本文件，因此一键启动无需修改这里。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 上传文件大小上限（单位：MB）
MAX_UPLOAD_MB=10

# 统一业务时区（风险提醒中的「今天」与截止时间均按该时区计算）
APP_TIMEZONE=Asia/Shanghai

# ===== OpenAI 兼容大模型 =====
# 云端兼容服务示例：填写服务地址、模型名和密钥。
# AI_PROVIDER=OpenAI 兼容服务
# AI_BASE_URL=https://your-provider.example/v1
# AI_MODEL=your-model
# AI_API_KEY=your-secret
#
# 本地 Ollama 示例（API Key 留空）：
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=qwen2.5:7b
# AI_API_KEY=
#
# 配置外部服务后，智能分析所需文档文本会发送到该服务；材料规则核验不调用 AI。
AI_PROVIDER=OpenAI 兼容服务
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=1
AI_MAX_INPUT_CHARS=60000

# ===== 本地 RapidOCR =====
# 图片和扫描 PDF 只在本机识别，不调用第三方 OCR 服务。
OCR_ENABLED=true
OCR_MAX_PAGES=50
OCR_PDF_DPI=200
OCR_PDF_TEXT_THRESHOLD=20
OCR_MAX_IMAGE_PIXELS=20000000
OCR_MIN_CONFIDENCE=0.5
# 分辨率下限是 DPI 的近似替代：低于阈值只提示 OCR 可能不准，不拒绝识别。
# 默认值覆盖 1440×900 / 1920×1080 屏幕截图，A4 @150DPI（1240×1754）不触发。
OCR_MIN_IMAGE_SIDE=1200
OCR_MIN_IMAGE_PIXELS=1500000

